


@model ICollection<Movie.Domain.DTOs.MovieDTO>





    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Release Date</th>
                <th>Studio Name</th>
            </tr>   
            
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.ReleaseYear</td>
                    <td>@movie.StudioName</td>
                </tr>
            }
            </tbody>
    </table>

  


