<table>
    <thead>

        <tr>
            <th>Title</th>
            <th>Release Year</th>
            <th>Studio Name</th>
        </tr>
   </thead>
       <tbody>
        @foreach (var movie in Model.Movies)
        {
            <tr>
                <td> @movie.Title </td>
                <td> @movie.ReleaseYear </td>
                <td> @movie.StudioName </td>

                <td>  <a class="btn btn-primary" asp-area="" asp-page="/Movies/Details" asp-route-id="@movie.Id">See Details</a> </td>
            </tr>
        }

       </tbody>

 </table>
